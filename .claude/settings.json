{
  "permissions": {
    "allow": [
      "Read",
      "Bash(ls *)",
      "Bash(tree *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(du *)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(nvidia-smi*)",
      "Bash(uv run *)",
      "Bash(uv sync*)"
    ],
    "deny": [
      "Read(./.env)",
      "Bash(*.env)",
      "Bash(*.env *)",
      "Bash(*.env\"*)",
      "Bash(*.env'*)"
    ],
    "ask": [
      "Bash(kaggle competitions submit)",
      "Bash(kaggle competitions submit *)",
      "Bash(kaggle c submit)",
      "Bash(kaggle c submit *)",
      "Bash(uv run kaggle competitions submit)",
      "Bash(uv run kaggle competitions submit *)",
      "Bash(uv run kaggle c submit)",
      "Bash(uv run kaggle c submit *)",
      "Bash(*submit_kernel*)"
    ]
  },
  "enabledPlugins": {
    "nvidia-kaggle@nvidia-kaggle": true
  },
  "extraKnownMarketplaces": {
    "nvidia-kaggle": {
      "source": {
        "source": "git",
        "url": "https://github.com/NVIDIA/nvidia-kaggle.git"
      }
    }
  }
}
