{
  "name": "GPU",
  "dockerComposeFile": ["../../compose.yaml", "../../compose.gpu.yaml"],
  "service": "dev",
  "workspaceFolder": "/workspace",
  "shutdownAction": "none",
  // 一般ユーザーを追加し、Linux ではその UID/GID をホストのユーザーに自動で合わせる
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "username": "vscode",
      "installZsh": false,
      "installOhMyZsh": false,
      "upgradePackages": false
    }
  },
  "containerUser": "vscode",
  "remoteUser": "vscode"
}
