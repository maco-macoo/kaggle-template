# リポジトリ直下に `.env` としてコピーし、実際の値を記入する（.env は git 管理外）
# 読み込み: set -a; source .env; set +a
# トークン発行: https://www.kaggle.com/settings → API
KAGGLE_API_TOKEN=

# 対象の Kaggle スラッグ（tools/ と skills が参照。秘密ではないので実値を記載してよい）
KAGGLE_COMPETITION=

# 自チーム識別子（tools/kag_common.py が参照）。チーム名の文字列一致で推定しないこと —
# 必ず `kaggle competitions team-submissions <ID>` の一覧に自分の submissionId
# （`kaggle competitions submissions $KAGGLE_COMPETITION` で取得）が含まれることを検証してから設定する
KAGGLE_TEAM_ID=
KAGGLE_TEAM_NAME=

# ---- Docker（マシンごとの設定。docker compose が自動で読む） ----
# コンテナをホストと同じ UID:GID で動かすための値
HOST_UID=    # id -u の値
HOST_GID=    # id -g の値
