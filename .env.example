# .env にコピーし、コンペごとに設定する（.env は git 管理外）
KAGGLE_API_TOKEN=
KAGGLE_COMPETITION=

# Linux で docker compose から起動するときはコメントを外し、id -u と id -g の値を書く（Dev Containers では不要）
# UID=1000
# GID=1000

# GPU を使うときだけコメントを外す（Dev Containers では GPU を選ぶ）
# COMPOSE_FILE=compose.yaml:compose.gpu.yaml

# 同じディレクトリ名のリポジトリを複数起動する場合だけ、一意な名前を設定する
# COMPOSE_PROJECT_NAME=kaggle-my-competition
