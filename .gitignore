# 認証情報
.env

# コンテナのホーム（エージェントのログイン情報・キャッシュ）
.home/*
!.home/.gitkeep

# Python / uv
.venv/
.cache/
__pycache__/
*.pyc
.ipynb_checkpoints/

# input/ と exp/*/output/ 以外の生成物（プラグインの DB など）
data/*
!data/.gitkeep

# 実験の出力
exp/*/output/

# コンペ提供データ
input/*
!input/.gitkeep

# サイズの大きいファイル
*.json.gz
*.tar.gz

# OS
Thumbs.db
.DS_Store
